if getprop("ro.boot.em.model") == "SM-A3360" && getprop("ro.boot.bootloader") != "A3360ZHSEFYH2" then
  ui_print("- Flashing bootloader firmware (A3360ZHSEFYH2)");
  package_extract_file("firmware/A3360ZHSEFYH2/modem.bin", "/dev/block/by-name/radio");
  package_extract_file("firmware/A3360ZHSEFYH2/up_param.bin", "/dev/block/by-name/up_param");
  package_extract_file("firmware/A3360ZHSEFYH2/vbmeta.img", "/dev/block/by-name/vbmeta");
  ui_print("- Flashing bota firmware (A3360ZHSEFYH2)");
  assert(write_data_bt("firmware/A3360ZHSEFYH2/fld.bin", "/dev/block/by-name/bota", 8, 4194304));
  assert(write_data_bt("firmware/A3360ZHSEFYH2/harx.bin", "/dev/block/by-name/bota", 4194348, 3145728));
  assert(write_data_bt("firmware/A3360ZHSEFYH2/keystorage.bin", "/dev/block/by-name/bota", 7340112, 524288));
  assert(write_data_bt("firmware/A3360ZHSEFYH2/ldfw.img", "/dev/block/by-name/bota", 7864436, 8388608));
  assert(write_data_bt("firmware/A3360ZHSEFYH2/sboot.bin", "/dev/block/by-name/bota", 16253080, 8388608));
  assert(write_data_bt("firmware/A3360ZHSEFYH2/tzar.img", "/dev/block/by-name/bota", 24641724, 7340816));
  assert(write_data_bt("firmware/A3360ZHSEFYH2/tzsw.img", "/dev/block/by-name/bota", 31982576, 1572864));
  assert(write_data_bt("firmware/A3360ZHSEFYH2/uh.bin", "/dev/block/by-name/bota", 33555476, 294312));
  assert(write_data_bt("firmware/A3360ZHSEFYH2/up_param.bin", "/dev/block/by-name/bota", 33849824, 3041280));
  assert(mark_header_bt("/dev/block/by-name/bota", 0, 9, 3142939818));
endif;
