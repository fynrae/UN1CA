# a33xzh (chn_hk)
on early-init && property:ro.boot.em.model=SM-A3360
    # Firmware blobs
    mount none /vendor/firmware/SM-A3360/AP_AUDIO_SLSI.bin /vendor/firmware/AP_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-A3360/APDV_AUDIO_SLSI.bin /vendor/firmware/APDV_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-A3360/mfc_fw.bin /vendor/firmware/mfc_fw.bin bind
    mount none /vendor/firmware/SM-A3360/NPU.bin /vendor/firmware/NPU.bin bind
    mount none /vendor/firmware/SM-A3360/os.checked.bin /vendor/firmware/os.checked.bin bind
    mount none /vendor/firmware/SM-A3360/vts.bin /vendor/firmware/vts.bin bind
    mount none /vendor/firmware/SM-A3360/calliope_sram.bin /vendor/firmware/calliope_sram.bin bind
    # TEEgris
    mount none /vendor/firmware/tee/SM-A3360 /vendor/tee bind

